@model Assignment01_EventSignup.Models.Attendee

@{
    ViewData["Title"] = "Delete Attendee";
    var eventItem = ViewBag.Event as Assignment01_EventSignup.Models.Event;
}

<h1>Delete Attendee - @eventItem?.Title</h1>

<h3>Are you sure you want to delete this attendee?</h3>

<div>
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Email:</strong> @Model.Email</p>
</div>

<form asp-action="DeleteConfirmed" asp-route-eventId="@Model.EventId" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-controller="Attendees" asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-link">Cancel</a>
</form>