@model IEnumerable<Assignment01_EventSignup.Models.Attendee>

@{
    ViewData["Title"] = "Attendees";
    var eventItem = ViewBag.Event as Assignment01_EventSignup.Models.Event;
}

<h2>Attendees</h2>

@if (eventItem != null)
{
    <p><strong>Event:</strong> @eventItem.Title</p>
    <p>
        <a asp-action="Create" asp-route-eventId="@eventItem.Id" class="btn btn-primary">Add Attendee</a>
        <a asp-controller="Events" asp-action="Details" asp-route-id="@eventItem.Id" class="btn btn-secondary">Back to Event</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var attendee in Model)
        {
            <tr>
                <td>@attendee.FullName</td>
                <td>@attendee.Email</td>
                <td>
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@attendee.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>