@model IEnumerable<Assignment01_EventSignup.Models.Event>

@{
    ViewData["Title"] = "Event Manager";
}

<h1>Event Manager</h1>

<p>
    <a asp-controller="Event" asp-action="Create" class="btn btn-primary">Create New Event</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Location</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Date</td>
                <td>@item.Location</td>
                <td>
                    <a asp-controller="Event" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-controller="Event" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-controller="Event" asp-action="Delete" asp-route-id="@item.Id">Delete</a> |
                    <a asp-controller="Attendees" asp-action="Index" asp-route-eventId="@item.Id">Attendees</a>
                </td>
            </tr>
        }
    </tbody>
</table>