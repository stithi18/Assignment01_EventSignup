@model Event

<h2>Manage Attendees – @Model.Title</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<h4>Sign Up for @Model.Title</h4>

<form asp-action="Signup" method="post">
    <input type="hidden" name="eventId" value="@Model.Id" />

    <div class="form-group">
        <label>Name</label>
        <input name="name" class="form-control" />
    </div>

    <div class="form-group">
        <label>Email</label>
        <input name="email" class="form-control" />
    </div>

    <br />
    <button class="btn btn-success">Sign Up</button>
    <a asp-action="Index" class="btn btn-secondary">Back to Events</a>
</form>

<hr />

<h4>Current Attendees (@Model.Attendees.Count)</h4>

@if (!Model.Attendees.Any())
{
    <p>No attendees yet.</p>
}
else
{
    <ul>
        @foreach (var a in Model.Attendees)
        {
            <li>@a.Name (@a.Email)</li>
        }
    </ul>
}
