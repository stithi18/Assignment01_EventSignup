@model Assignment01_EventSignup.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<h1>Delete Event</h1>

<h3>Are you sure you want to delete this event?</h3>

<div>
    <p><strong>Title:</strong> @Model.Title</p>
    <p><strong>Date:</strong> @Model.Date</p>
    <p><strong>Location:</strong> @Model.Location</p>
</div>

<form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>