@model Assignment01_EventSignup.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<h1>Event Details</h1>

<div>
    <h4>@Model.Title</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">Date</dt>
        <dd class="col-sm-10">@Model.Date.ToShortDateString()</dd>

        <dt class="col-sm-2">Location</dt>
        <dd class="col-sm-10">@Model.Location</dd>
    </dl>
</div>

<div>
    @if (User.IsInRole("Organizer"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <span>|</span>
        <a asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
        <span>|</span>
        <a asp-controller="Attendees" asp-action="Create" asp-route-eventId="@Model.Id">Add Attendee</a>
        <span>|</span>
    }

    <a asp-action="Index">Back to List</a>
</div>

<hr />
<h3>Attendees</h3>

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    if (Model.Attendees != null && Model.Attendees.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    @if (User.IsInRole("Organizer"))
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var attendee in Model.Attendees)
                {
                    <tr>
                        <td>@attendee.FullName</td>
                        <td>@attendee.Email</td>

                        @if (User.IsInRole("Organizer"))
                        {
                            <td>
                                <a asp-controller="Attendees" asp-action="Delete" asp-route-id="@attendee.Id">
                                    Remove
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No attendees registered yet.</p>
    }
}
else
{
    <p>Login to view attendee list.</p>
}