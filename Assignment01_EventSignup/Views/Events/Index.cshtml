@model IEnumerable<Assignment01_EventSignup.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<h2>Events</h2>

@if (User.IsInRole("Organizer"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Event</a>
    </p>
}

@foreach (var item in Model)
{
    <div style="border:1px solid #ccc; padding:15px; margin-bottom:15px;">
        <h3>@item.Title</h3>
        <p>@item.Description</p>
        <p><strong>Date:</strong> @item.Date.ToString("f")</p>
        <p><strong>Location:</strong> @item.Location</p>

        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">View Details</a>

        @if (User.IsInRole("Organizer"))
        {
            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
        }
    </div>
}